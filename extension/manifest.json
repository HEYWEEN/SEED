{
  "manifest_version": 3,
  "name": "SEED",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "SEED for software engineering discussions on GitHub.",
  "key": "",
  "icons": {
    "128": "seed-button.png"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
